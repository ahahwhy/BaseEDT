#Область ОбработчикиСобытий

Функция НомерДокументаМетод(Запрос)
	// 1. Получаем параметр
	Номер = Запрос.ПараметрыЗапроса.Получить("Номер");
	
	Если Номер = Неопределено ИЛИ Номер = "" Тогда
		Возврат СформироватьОтветОшибки(400, "Параметр 'Номер' не передан или пуст");
	КонецЕсли;
	
	// 2. Ищем документ
	ЗапросДок = Новый Запрос;
	ЗапросДок.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Приход ГДЕ Номер = &Номер";
	ЗапросДок.УстановитьПараметр("Номер", Номер);
	ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
	
	Если Не ВыборкаДок.Следующий() Тогда
		Возврат СформироватьОтветОшибки(404, "Документ с номером " + Номер + " не найден");
	КонецЕсли;
	
	// 3. Получаем объект документа
	ДокОбъект = ВыборкаДок.Ссылка.ПолучитьОбъект();
	
	// 4. Формируем данные шапки
	ДанныеДокумента = Новый Структура();
	ДанныеДокумента.Вставить("Номер", Строка(ДокОбъект.Номер));
	ДанныеДокумента.Вставить("Дата", Формат(ДокОбъект.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	
	// 5. Формируем данные табличной части
	МассивТоваров = Новый Массив();
	Для Каждого СтрокаТЧ Из ДокОбъект.Номенклатура Цикл
		ТоварJSON = Новый Структура();
		ТоварJSON.Вставить("Товар", Строка(СтрокаТЧ.Товар));
		ТоварJSON.Вставить("Количество", Строка(СтрокаТЧ.Количество));
		ТоварJSON.Вставить("Цена", Строка(СтрокаТЧ.Цена));
		ТоварJSON.Вставить("Сумма", Строка(СтрокаТЧ.Сумма));
		ТоварJSON.Вставить("ЕдиницаИзмерения", Строка(СтрокаТЧ.ЕдиницаИзмерения));
		
		МассивТоваров.Добавить(ТоварJSON);
	КонецЦикла;
	
	ДанныеДокумента.Вставить("Товары", МассивТоваров);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеДокумента);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8");
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Возврат Ответ;
	
КонецФункции


