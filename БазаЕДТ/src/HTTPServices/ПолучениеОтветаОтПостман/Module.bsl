#Область СлужебныеПроцедурыИФункции

Функция СформироватьОтветОшибки(КодСтатуса, ТекстОшибки)
	Ответ = Новый HTTPСервисОтвет(КодСтатуса);
	СтруктураОшибки = Новый Структура("error", ТекстОшибки);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОшибки);
	
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8");
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Возврат Ответ;
КонецФункции

#КонецОбласти