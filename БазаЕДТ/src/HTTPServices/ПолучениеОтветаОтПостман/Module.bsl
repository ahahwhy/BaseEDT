	МассивТоваров = Новый Массив();
	Для Каждого СтрокаТЧ Из ДокОбъект.Номенклатура Цикл
		ТоварJSON = Новый Структура();
		ТоварJSON.Вставить("Товар", Строка(СтрокаТЧ.Товар));
		ТоварJSON.Вставить("Количество", Строка(СтрокаТЧ.Количество));
