	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	
	ЗаписьJSON.ЗаписатьИмяСвойства("Номер");
	ЗаписьJSON.ЗаписатьЗначение(ДанныеДокумента.Номер);

	ЗаписьJSON.ЗаписатьИмяСвойства("Дата");
	ЗаписьJSON.ЗаписатьЗначение(ДанныеДокумента.Дата);

	ЗаписьJSON.ЗаписатьИмяСвойства("Товары");
	ЗаписьJSON.ЗаписатьНачалоМассива();

	Для Каждого СтрокаТЧ Из ДанныеДокумента.Товары Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();

		ЗаписьJSON.ЗаписатьИмяСвойства("Товар");
		ЗаписьJSON.ЗаписатьЗначение(СтрокаТЧ.Товар);

		ЗаписьJSON.ЗаписатьИмяСвойства("Количество");
		ЗаписьJSON.ЗаписатьЗначение(СтрокаТЧ.Количество);

		ЗаписьJSON.ЗаписатьИмяСвойства("Цена");
		ЗаписьJSON.ЗаписатьЗначение(СтрокаТЧ.Цена);

		ЗаписьJSON.ЗаписатьИмяСвойства("Сумма");
		ЗаписьJSON.ЗаписатьЗначение(СтрокаТЧ.Сумма);

		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;

	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();

	СтрокаJSON = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8");
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Возврат Ответ;


КонецФункции

