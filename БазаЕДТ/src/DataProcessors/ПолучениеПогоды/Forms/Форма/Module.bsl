&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Устанавливаем город по умолчанию (если нужно)
	Город = Справочники.Города.НайтиПоНаименованию("Тюмень");
	
КонецПроцедуры

&НаКлиенте
Процедура ГородПриИзменении(Элемент)
	// Показываем элементы для вывода результата
	Элементы.Температура.Видимость = Истина;
	Элементы.Описание.Видимость = Истина;
	
	// Вызываем серверную процедуру
	ПолучитьПогодуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьПогодуНаСервере()
	
	Если Город.Пустая() Тогда
		Сообщить("Выберите город!");
		Возврат;
	КонецЕсли;
	
	Широта = 57.1522;
	Долгота = 65.5272;
	
	APIКлюч = "56cb33fa-bd13-4601-ab7d-29cd72de6874"; 
	
	СтрокаШироты = СтрЗаменить(Строка(Широта), ",", ".");
	СтрокаДолготы = СтрЗаменить(Строка(Долгота), ",", ".");
	
	Попытка
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение("api.weather.yandex.ru", 443, , , , , ЗащищенноеСоединение);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("X-Yandex-Weather-Key", APIКлюч);
		
		Запрос = Новый HTTPЗапрос("/v2/forecast?lat=" + СтрокаШироты + "&lon=" + СтрокаДолготы);
		Запрос.Заголовки = Заголовки;
		
		Ответ = Соединение.Получить(Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			ДанныеПогоды = ПрочитатьJSON(ЧтениеJSON, Истина);
			
			// Безопасная проверка наличия свойства с учетом типа
			ЕстьФакт = Ложь;
			Если ТипЗнч(ДанныеПогоды) = Тип("Структура") Тогда
				ЕстьФакт = ДанныеПогоды.Свойство("fact");
			ИначеЕсли ТипЗнч(ДанныеПогоды) = Тип("Соответствие") Тогда
				ЕстьФакт = (ДанныеПогоды.Получить("fact") <> Неопределено);
			КонецЕсли;
			
			Если ЕстьФакт Тогда
				// Получаем блок fact в зависимости от типа
				Если ТипЗнч(ДанныеПогоды) = Тип("Структура") Тогда
					ТекущаяПогода = ДанныеПогоды.fact;
				Иначе
					ТекущаяПогода = ДанныеПогоды.Получить("fact");
				КонецЕсли;
				
				// Извлекаем данные аналогичным безопасным способом
				Температура = Строка(ПолучитьЗначениеИзОбъекта(ТекущаяПогода, "temp")) + " °C";
				Описание = "Состояние: " + ПолучитьЗначениеИзОбъекта(ТекущаяПогода, "condition") + 
				           ", Влажность: " + ПолучитьЗначениеИзОбъекта(ТекущаяПогода, "humidity") + "%" +
				           ", Ветер: " + ПолучитьЗначениеИзОбъекта(ТекущаяПогода, "wind_speed") + " м/с";
			Иначе
				Сообщить("Не удалось найти блок 'fact' в ответе. Сырой ответ: " + ТелоОтвета);
			КонецЕсли;
			
		Иначе
			ТелоОшибки = Ответ.ПолучитьТелоКакСтроку();
			Сообщить("Ошибка HTTP: " + Ответ.КодСостояния + Символы.ПС + ТелоОшибки);
		КонецЕсли;
		
	Исключение
		Сообщить("Ошибка при запросе к API: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Универсальная функция для получения значения из Структуры или Соответствия
&НаСервере
Функция ПолучитьЗначениеИзОбъекта(Объект, ИмяСвойства)
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(ИмяСвойства) Тогда
			Возврат Объект[ИмяСвойства];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Значение = Объект.Получить(ИмяСвойства);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции