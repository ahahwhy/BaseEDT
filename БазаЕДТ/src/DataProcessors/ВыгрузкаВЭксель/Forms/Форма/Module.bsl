// @strict-types
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыгрузитьВЭксель(Команда)

	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.Каталог = "";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите каталог для выгрузки";

	ДопПараметры = Новый Структура("Диалог", ДиалогОткрытияФайла);
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьЗавершение", ЭтотОбъект, ДопПараметры);

	ДиалогОткрытияФайла.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзЭксель(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите файл Excel";
	ПараметрыДиалога.Фильтр = "Excel (*.xls, *.xlsx)|*.xls;*.xlsx|Все файлы (*.*)|*.*";
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	ОписаниеОповещения = Новый ОписаниеОповещения("ПомещениеФайлаЗавершение", ЭтотОбъект);

	НачатьПомещениеФайлаНаСервер(ОписаниеОповещения, , , , ПараметрыДиалога, ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  АдресВХ - Строка
//  РасширениеФайла - Строка
&НаСервере
Процедура ПрочитатьExcelНаСервере(АдресВХ, РасширениеФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХ);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	//@skip-check dynamic-access-method-not-found
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		УдалитьФайлы(ИмяВременногоФайла);
	ВызватьИсключение "Не удалось прочитать файл Excel: " + ОписаниеОшибки();
	КонецПопытки;

	УдалитьФайлы(ИмяВременногоФайла);

	Объект.ТоварыЗагрузка.Очистить();

	Для Стр = 1 По ТабДок.ВысотаТаблицы Цикл

		Наименование    = ТабДок.Область(Стр, 1).Текст;
		КоличествоТекст = ТабДок.Область(Стр, 2).Текст;

		Если ПустаяСтрока(Наименование) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.ТоварыЗагрузка.Добавить();
		НоваяСтрока.Номенклатура = Наименование;
		НоваяСтрока.Количество   = ?(ПустаяСтрока(КоличествоТекст), 0, Число(КоличествоТекст));

	КонецЦикла;

КонецПроцедуры 

// Параметры:
//  ОписаниеПомещенногоФайла - Структура:
//   * ПомещениеФайлаОтменено - Булево
//   * Адрес - Строка - адрес помещённого файла во временном хранилище
//   * СсылкаНаФайл - Структура:
//       ** Файл - Файл - объект файла:
//           *** Путь - Строка
//           *** ИмяБезРасширения - Строка
//           *** Расширение - Строка
//   * Размер - Число
//   * ИдентификаторФормы - УникальныйИдентификатор
//  ДополнительныеПараметры - Произвольный
&НаКлиенте
Процедура ПомещениеФайлаЗавершение(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеПомещенногоФайла = Неопределено ИЛИ ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		ПоказатьОповещениеПользователя("Файл не выбран или помещение отменено.");
		Возврат;
	КонецЕсли;

	АдресВХ = ОписаниеПомещенногоФайла.Адрес;

	Путь = "";
	Попытка
		ПомещенныйФайл = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл;
		Путь = ПомещенныйФайл.Путь + ПомещенныйФайл.ИмяБезРасширения + ПомещенныйФайл.Расширение;
	Исключение
	КонецПопытки;

	РасширениеФайла = "xls";
	Если НЕ ПустаяСтрока(Путь) Тогда
		ФайлИнформация = Новый Файл(Путь);
		Если НЕ ПустаяСтрока(ФайлИнформация.Расширение) Тогда
			РасширениеФайла = ФайлИнформация.Расширение;
		КонецЕсли;
	КонецЕсли;

	ПрочитатьExcelНаСервере(АдресВХ, РасширениеФайла);
	Модифицированность = Истина;

КонецПроцедуры

// Оповещение о завершении выгрузки.
// Параметры:
//  Результат - Булево - результат операции.
//  ДополнительныеПараметры - Структура - дополнительные параметры.
&НаКлиенте
Процедура ПослеЗаписиФайла(Результат, ДополнительныеПараметры) Экспорт
	Если Результат Тогда
		ПоказатьОповещениеПользователя("Выгрузка данных успешно завершена!");
	Иначе
		ПоказатьОповещениеПользователя("Не удалось сохранить файл.");
	КонецЕсли;
КонецПроцедуры

// Параметры:
//  Наименование - Строка. 
//  Количество - Число.
//  ТабДок - ТабличныйДокумент.
&НаСервере
Процедура ЗаполнитьТаблицуНаСервере(ТабДок)

	Макет = Обработки.ВыгрузкаВЭксель.ПолучитьМакет("Макет");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

	 Для Каждого СтрокаТЧ Из Объект.ТоварыВыгрузка Цикл
 
		//@skip-check property-return-type
		ОбластьСтрока.Параметры.Наименование = СтрокаТЧ.Номенклатура;
		//@skip-check property-return-type
		ОбластьСтрока.Параметры.Количество   = СтрокаТЧ.Количество;

		ТабДок.Вывести(ОбластьСтрока);

	КонецЦикла;

КонецПроцедуры

//Параметры:
//  ВыбранныеФайлы - Массив из Строка.
//  ДополнительныеПараметры - Структура.
&НаКлиенте
Процедура ВыгрузитьЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПутьККаталогу = ВыбранныеФайлы[0];

	Если Прав(ПутьККаталогу, 1) <> "\" Тогда
		Объект.КаталогСохранения = ПутьККаталогу + "\";
	Иначе
		Объект.КаталогСохранения = ПутьККаталогу;
	КонецЕсли;

	ДатаИВремя = СтрЗаменить(Строка(ТекущаяДата()), ":", ".");
	ИмяФайла = "Импорт_" + ДатаИВремя;
	ПолноеИмяФайла = Объект.КаталогСохранения + ИмяФайла + ".xls";

	ТабДок = Новый ТабличныйДокумент;
	ЗаполнитьТаблицуНаСервере(ТабДок);

	ОповещениеОЗаписи = Новый ОписаниеОповещения("ПослеЗаписиФайла", ЭтотОбъект);
	ТабДок.НачатьЗапись(ОповещениеОЗаписи, ПолноеИмяФайла, ТипФайлаТабличногоДокумента.xls);

КонецПроцедуры

#КонецОбласти